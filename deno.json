{
  "name": "@casefile/casefile",
  "version": "0.2.0",
  "exports": "./src/cli/main.ts",
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net=127.0.0.1,localhost --allow-sys --allow-ffi",
    "check": "deno check src tests",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "ci": "deno fmt --check && deno lint && deno task check && deno task test",
    "cli": "deno run --allow-read --allow-write --allow-env --deny-net src/cli/main.ts",
    "build:cli": "deno compile --allow-read --allow-write --allow-env --deny-net --output bin/casefile src/cli/main.ts",
    "seed": "deno run --allow-read --allow-write --allow-env --allow-ffi --allow-sys scripts/seed.ts",
    "app": "deno run --allow-read --allow-write --allow-env --allow-net --allow-ffi --allow-sys --allow-run=open src/app/main.ts",
    "dev": "CASEFILE_DEV_CASES=.dev CASEFILE_CONFIG_DIR=.dev/canon.config CASEFILE_PORT=8218 deno run --allow-read --allow-write --allow-env --allow-net --allow-ffi --allow-sys --allow-run=open src/app/main.ts",
    "judge-eval": "deno run --env-file=.env --allow-read --allow-write --allow-env --allow-ffi --allow-sys --allow-net=127.0.0.1,localhost,huggingface.co,api.typesafe.ai scripts/judge-eval.ts",
    "browsercheck": "deno run --allow-read --allow-write --allow-env --allow-net --allow-ffi --allow-sys --allow-run scripts/browsercheck.ts",
    "seed:dev": "deno run --allow-read --allow-write --allow-env --allow-ffi --allow-sys scripts/seed.ts --dir .dev/canon --force",
    "desktop": "deno run --allow-read --allow-write --allow-env --allow-run scripts/build_desktop.ts",
    "release:keygen": "deno run --allow-read --allow-write scripts/release/keygen.ts",
    "release:manifest": "deno run --allow-read --allow-write --allow-env scripts/release/manifest.ts"
  },
  "unstable": ["worker-options"],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/encoding": "jsr:@std/encoding@^1",
    "@std/cli": "jsr:@std/cli@^1",
    "@huggingface/transformers": "npm:@huggingface/transformers@^3",
    "unpdf": "npm:unpdf@~1.8.1",
    "docx": "npm:docx@9.7.2",
    "playwright": "npm:playwright@1.56.1"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "docs/",
      "bin/",
      "dist/"
    ]
  },
  "lint": {
    "exclude": [
      "bin/",
      "dist/",
      "src/app/ui/"
    ],
    "rules": {}
  },
  "exclude": [
    "bin/",
    "dist/",
    ".claude/",
    ".dev/",
    ".browsercheck/"
  ]
}
